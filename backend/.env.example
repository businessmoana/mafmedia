PORT=3001
JWT_SECRET=your-super-secret-jwt-key-change-in-production
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=media_crm

# Telegram Mini App
# From @BotFather: create a bot and get the token. Set the Mini App URL to your frontend URL.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs that should get admin role when they first open the app
TELEGRAM_ADMIN_IDS=

# Browser testing: set to true to sign in as admin on localhost (no Telegram)
ALLOW_DEV_ADMIN=true
